{
  "name": "atharva-attarde-blog",
  "version": "1.0.0",
  "description": "Atharva's Blog - Static site built from Markdown",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && echo 'Build complete!'",
    "watch": "chokidar 'src/**/*.md' -c 'npm run build'"
  },
  "keywords": [
    "blog",
    "static-site",
    "markdown"
  ],
  "author": "Atharva Attarde",
  "license": "MIT",
  "dependencies": {
    "marked": "^11.1.1"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0"
  }
}
